                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidName",
              "messageStrings": {
                "issue": {
                  "text": "Name isn't valid. '{0}' isn't recognized."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Remove or correct the reference to the name that isn't valid."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrCollectionDoesNotAcceptThisType",
              "messageStrings": {
                "issue": {
                  "text": "Incompatible type. The collection can't contain values of this type."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "You might need to convert the type of the item using, for example, a Datevalue, Text, or Value function."
                ],
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidArgs-Func",
              "messageStrings": {
                "issue": {
                  "text": "The function '{0}' has some invalid arguments."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-SuggestRemoteExecutionHint-OpNotSupportedByColumn",
              "messageStrings": {
                "issue": {
                  "text": "Delegation warning. The highlighted part of this formula might not work correctly with column \"{0}\" on large data sets."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.",
                  "Try simplifying the formula.",
                  "Try moving your data to a different data source."
                ],
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrIncompatibleTypesForEquality-Left-Right",
              "messageStrings": {
                "issue": {
                  "text": "Incompatible types for comparison. These types can't be compared: {0}, {1}."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "You might need to convert the value to be the same type, such as converting a date string (e.g., \"12/31/2018\") to a date value.",
                  "If you're comparing records or tables, the field or column types must match exactly."
                ],
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-WarnInvalidTypeForVariableDefinition",
              "messageStrings": {
                "issue": {
                  "text": "The variable {0} needs to have a non-Blank type. If this is the only place that {0} is defined, resolve this by adding another definition elsewhere that assigns a non-Blank value to this variable."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "acc-AccessibleLabelNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing accessible label"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Edit the accessible label property to describe the item."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls."
              }
            },
            {
              "id": "acc-FocusBorderShouldBeVisible",
              "messageStrings": {
                "issue": {
                  "text": "Focus isn't showing"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Change the FocusedBorderThickness property to be more than 0."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app."
              }
            },
            {
              "id": "acc-TabIndexShouldBeDefinedForInteractiveControl",
              "messageStrings": {
                "issue": {
                  "text": "Missing tab stop"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "People who use the keyboard with your app will not be able to access this element without a tab stop."
              }
            },
            {
              "id": "acc-StateIndicationTextNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Add State indication text"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set ShowValue = true to show the current state of the control."
                ],
                "level": "Low",
                "primaryCategory": "accessibility",
                "whyFix": "Users won't get confirmation of their actions if the state of the control isn't showing."
              }
            },
            {
              "id": "app-UnusedVariables",
              "messageStrings": {
                "issue": {
                  "text": "Variable no utilizada"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Quite la variable no utilizada."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Esta variable está declarada, pero ningún control hace referencia a ella, por lo que no es necesaria."
              }
            },
            {
              "id": "app-CollectDelegatableDataSource",
              "messageStrings": {
                "issue": {
                  "text": "Es posible que las filas recuperadas del origen de datos no estén completas."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Limite los datos recopilados del origen de datos actualizando la fórmula \"ClearCollect(colRegistros; RegistrosFormacion)\" para incluir una función de filtrado, como \"Filter\" o \"Search\"."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Si el origen de datos es demasiado grande, es posible que el uso de la función \"Collect\" para crear una colección directamente a partir de un origen de datos conectado no cargue todas las filas."
              }
            },
            {
              "id": "app-CollectingReadOnlyTable",
              "messageStrings": {
                "issue": {
                  "text": "La colección está inicializada, pero nunca actualizada"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Reemplace Collect o ClearCollect por una fórmula con nombre en App.Formulas. Por ejemplo, MyTable = Filter(origen, condición). Las fórmulas con nombre se calculan cuando sus entradas cambian y no conllevan el costo de seguimiento de una colección."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Las colecciones están diseñadas para actualizarse. Power Apps realiza un trabajo adicional para realizar un seguimiento de cada colección de modo que todo lo que dependa de ella permanezca sincronizado cuando cambien los datos. Cuando los datos nunca cambian después de establecerlos, se desperdicia el trabajo de seguimiento. Una fórmula con nombre proporciona los mismos datos sin el costo adicional."
              }
            },
            {
              "id": "app-CrossScreenEventDependencies",
              "messageStrings": {
                "issue": {
                  "text": "La regla de eventos hace referencia a un control en otra pantalla"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Mueva el trabajo a un evento en la pantalla propietaria (por ejemplo, Screen.OnVisible), pase el estado entre pantallas mediante el parámetro de contexto de Navigate o una variable global y reaccione a este en la pantalla de destino."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Las reglas de eventos (como OnStart, OnVisible y OnSelect) que hacen referencia a controles en otras pantallas obligan a esas pantallas a cargarse e inicializarse antes, incluso si el usuario nunca navega a ellas. Esto puede ralentizar notablemente el inicio y la navegación de la aplicación."
              }
            },
            {
              "id": "app-InefficientDelayLoading",
              "messageStrings": {
                "issue": {
                  "text": "Retraso de carga ineficiente"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Use variables, colecciones y contexto de navegación para compartir el estado entre pantallas en su lugar."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Los controles que hacen referencia a controles en otras pantallas pueden ralentizar la carga y la navegación de la aplicación. Al hacer esto, puede que se fuerce a la aplicación a cargar las otras pantallas de inmediato, en lugar de esperar hasta que el usuario navegue a esa pantalla."
              }
            },
            {
              "id": "app-ForAllWithMutation",
              "messageStrings": {
                "issue": {
                  "text": "La mutación de una colección o un origen de datos dentro de ForAll puede desencadenar una reevaluación excesiva de la regla"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Dado que ForAll devuelve una tabla, pase su resultado como entrada a la función de mutación en una llamada por lotes única. Por ejemplo, reemplace ForAll(source, Collect(c, { ... })) por Collect(c, ForAll(source, { ... })); el mismo patrón se aplica a Patch y Remove. Una mutación por lotes única emite una notificación de cambio en lugar de una por iteración.",
                  "En el caso de las actualizaciones o eliminaciones triviales por fila con un origen de datos, se prefieren las funciones UpdateIf o RemoveIf delegables a las que se llama una vez fuera de ForAll en lugar de iterar con ForAll."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "El uso de Collect, Patch, Remove u otra función de mutación dentro del cuerpo de ForAll muta la colección de destino o el origen de datos una vez por iteración. Cada propiedad de control que depende de esa colección u origen de datos se vuelve a evaluar en cada mutación, lo que puede convertir un pequeño bucle en miles de evaluaciones de reglas y, para los orígenes de datos conectados, una solicitud de red por fila."
              }
            },
            {
              "id": "app-CountRowsGalleryAllItems",
              "messageStrings": {
                "issue": {
                  "text": "Usar AllItemsCount en lugar de CountRows con AllItems"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Reemplace CountRows(Gallery.AllItems) por Gallery.AllItemsCount para mejorar el rendimiento."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "El uso de CountRows con la propiedad AllItems de una galería fuerza la creación de una tabla de salida que contiene una copia del origen de datos de entrada y el estado actual de todos los controles secundarios. Esto puede forzar la inicialización de filas no inicializadas, consumiendo ciclos de CPU adicionales, memoria y potencialmente desencadenando solicitudes de red de nivel de fila."
              }
            }
          ],
          "version": "1.349"
        }
      }
    }
  ],
  "version": "2.1.0"
}